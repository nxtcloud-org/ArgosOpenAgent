# ArgosOpen Agent 런타임 변수
#
# init 을 쓰면 이 파일은 필요 없습니다 — init 이 EC2 메타데이터에서 식별자를 읽어
# .env 를 직접 만듭니다. 수동 배포할 때만 복사해서 채우세요:
#   cp .env.example .env
#
# 여기에는 "런타임 값"만 둡니다. 수집 항목이나 컨테이너 구성은
# config.alloy / docker-compose.yml 에서 관리합니다.

MIMIR_ENDPOINT=http://<중앙노드_IP>:9009/api/v1/push
LOKI_ENDPOINT=http://<중앙노드_IP>:3100/loki/api/v1/push

# 메트릭·로그에 붙는 라벨. instance 는 고유 식별자, node 는 사람이 읽는 이름.
INSTANCE_ID=
NODE_NAME=
